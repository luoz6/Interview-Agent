{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interview-quality-gate-config-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "config_id", "effective_date", "change_policy", "formulas", "algorithm_parameters", "metric_groups", "cohort_dimensions"],
  "properties": {
    "schema_version": {"const": "interview-quality-gate-config-v1"},
    "config_id": {"type": "string", "minLength": 1},
    "effective_date": {"type": "string", "format": "date"},
    "change_policy": {"type": "object"},
    "formulas": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "algorithm_parameters": {"type": "object", "additionalProperties": {"type": "number"}},
    "cohort_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metric_groups": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"$ref": "#/$defs/metricRule"}
      }
    }
  },
  "$defs": {
    "metricRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "threshold", "unit", "severity", "min_sample_size"],
      "properties": {
        "operator": {"enum": ["gte", "lte", "eq", "record"]},
        "threshold": {"type": ["number", "null"]},
        "unit": {"type": "string", "minLength": 1},
        "severity": {"enum": ["blocking", "warning"]},
        "min_sample_size": {"type": "integer", "minimum": 1},
        "formula": {"type": ["string", "null"]},
        "baseline_mode": {"enum": ["none", "max_lower", "min_upper"]},
        "baseline_multiplier": {"type": "number", "exclusiveMinimum": 0},
        "requires_comparable_baseline": {"type": "boolean"}
      }
    }
  }
}
