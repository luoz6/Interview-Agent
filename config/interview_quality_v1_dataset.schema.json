{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interview-quality-dataset-contract-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "dataset_version", "description", "fixture_only", "cases"],
  "properties": {
    "schema_version": {"const": "interview-quality-dataset-contract-v1"},
    "dataset_id": {"enum": ["initial-question-quality-v1", "followup-decision-quality-v1", "report-score-quality-v2", "report-semantic-quality-v1"]},
    "dataset_version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "fixture_only": {"type": "boolean"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "case_version", "language", "case_type", "question_type", "difficulty", "quality_label", "partition", "source_boundary", "input", "expectation", "must_have_evidence", "forbidden_inference", "annotation", "provider_allowed", "gate_eligible", "hashes"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "case_version": {"type": "integer", "minimum": 1},
        "language": {"enum": ["zh-Hans", "en", "mixed"]},
        "case_type": {"enum": ["initial_question", "followup_decision", "report_score", "report_semantic"]},
        "question_type": {"enum": ["technical", "system_design", "project", "behavioral", "mixed"]},
        "difficulty": {"enum": ["foundation", "intermediate", "advanced"]},
        "quality_label": {"enum": ["strong", "medium", "partial", "incorrect", "off_topic", "empty", "not_applicable"]},
        "partition": {"enum": ["train", "dev", "blind-test"]},
        "source_boundary": {"$ref": "#/$defs/sourceBoundary"},
        "input": {"type": "object", "minProperties": 1},
        "expectation": {"$ref": "#/$defs/expectation"},
        "must_have_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "forbidden_inference": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "annotation": {"$ref": "#/$defs/annotation"},
        "provider_allowed": {"type": "boolean"},
        "gate_eligible": {"type": "boolean"},
        "hashes": {"$ref": "#/$defs/hashes"}
      }
    },
    "sourceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "description", "contains_real_candidate_data", "contains_employer_confidential_data", "contains_principal_memory"],
      "properties": {
        "classification": {"enum": ["synthetic", "public", "redacted"]},
        "description": {"type": "string", "minLength": 1},
        "contains_real_candidate_data": {"const": false},
        "contains_employer_confidential_data": {"const": false},
        "contains_principal_memory": {"const": false}
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "score_range"],
      "properties": {
        "action": {"type": ["string", "null"], "minLength": 1},
        "score_range": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 100}, {"type": "integer", "minimum": 0, "maximum": 100}], "items": false, "minItems": 2, "maxItems": 2}
          ]
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotator_id", "reviewer_id", "review_status", "dispute_status", "resolution"],
      "properties": {
        "annotator_id": {"type": "string", "minLength": 1},
        "reviewer_id": {"type": ["string", "null"]},
        "review_status": {"enum": ["pending", "reviewed"]},
        "dispute_status": {"enum": ["none", "open", "resolved"]},
        "resolution": {"type": ["string", "null"]}
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "source_sha256", "content_sha256"],
      "properties": {
        "algorithm": {"const": "sha256-canonical-json-v1"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
