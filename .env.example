# Local V1 Interview Agent configuration.
# Copy this file to .env or set the variables in PowerShell before starting the server.

# PostgreSQL + pgvector
POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/interview
POSTGRES_BUSINESS_POOL_MIN_SIZE=1
POSTGRES_BUSINESS_POOL_MAX_SIZE=12
POSTGRES_BUSINESS_POOL_ACQUIRE_TIMEOUT_SECONDS=2
POSTGRES_TELEMETRY_POOL_MIN_SIZE=1
POSTGRES_TELEMETRY_POOL_MAX_SIZE=4
POSTGRES_TELEMETRY_POOL_ACQUIRE_TIMEOUT_SECONDS=1
POSTGRES_LOCK_POOL_MIN_SIZE=1
POSTGRES_LOCK_POOL_MAX_SIZE=4
POSTGRES_LOCK_POOL_ACQUIRE_TIMEOUT_SECONDS=2
POSTGRES_CHECKPOINTER_POOL_MIN_SIZE=1
POSTGRES_CHECKPOINTER_POOL_MAX_SIZE=2
POSTGRES_CHECKPOINTER_POOL_ACQUIRE_TIMEOUT_SECONDS=2
POSTGRES_CHECKPOINTER_POOL_OVERHEAD=1
POSTGRES_CONNECT_TIMEOUT_SECONDS=3
POSTGRES_POOL_DRAIN_TIMEOUT_SECONDS=10
POSTGRES_POOL_MAX_LIFETIME_SECONDS=1800
POSTGRES_POOL_MAX_IDLE_SECONDS=300
POSTGRES_EXPECTED_API_PROCESSES=1
POSTGRES_EXPECTED_CELERY_PROCESSES=1
POSTGRES_EXPECTED_OUTBOX_PROCESSES=1
POSTGRES_EXTERNAL_CONNECTION_RESERVE=10
POSTGRES_CAPACITY_MAX_UTILIZATION=0.80
POSTGRES_RUNTIME_AUTO_MIGRATE=false
PGVECTOR_TABLE=knowledge_chunks
EMBEDDING_PROVIDER=disabled
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=siliconflow-current
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONNECT_TIMEOUT_SECONDS=5
EMBEDDING_READ_TIMEOUT_SECONDS=30
SILICONFLOW_API_KEY=

# Report runtime profile
# The checked-in example defaults to a dependency-free UI preview. It uses an
# in-memory session/job authority and deterministic static knowledge. Do not
# mix individual values from the preview and durable profiles.
REPORT_RUNTIME_PROFILE=preview
INTERVIEW_RUNTIME_STORE=memory
REPORT_JOB_STORE=memory
REPORT_WORKER=in_process
KNOWLEDGE_STORE=static

# Durable report profile (enable all five values together after migrations,
# pgvector corpus activation, and embedding credentials pass preflight):
# REPORT_RUNTIME_PROFILE=durable
# INTERVIEW_RUNTIME_STORE=postgres
# REPORT_JOB_STORE=postgres
# REPORT_WORKER=external_process
# REPORT_JOB_LEASE_SECONDS=45
# REPORT_JOB_STALL_SECONDS=90
# KNOWLEDGE_STORE=pgvector
# EMBEDDING_PROVIDER=siliconflow

# Runtime persistence
INTERVIEW_RUNTIME_TABLE_PREFIX=interview
INTERVIEW_DRAFT_TTL_SECONDS=604800
PREP_PLAN_TTL_SECONDS=86400
PREP_PLAN_EXPIRED_GRACE_SECONDS=86400
PREP_PLAN_CONSUMED_RETENTION_SECONDS=604800
INTERVIEW_EVENT_BACKEND=local
RUNTIME_OUTBOX_BATCH_SIZE=20
RUNTIME_OUTBOX_LEASE_SECONDS=60
RUNTIME_OUTBOX_POLL_SECONDS=0.5
RUNTIME_OUTBOX_MAX_ATTEMPTS=5
RUNTIME_RECEIPT_LEASE_SECONDS=300
INTERVIEW_LANGGRAPH_ROLLOUT_PERCENT=0
INTERVIEW_LANGGRAPH_RUNTIME_ENABLED=true
INTERVIEW_LANGGRAPH_VERSION=langgraph-v1
REPORT_LANGGRAPH_ROLLOUT_PERCENT=0
REPORT_LANGGRAPH_RUNTIME_ENABLED=true
REPORT_LANGGRAPH_VERSION=langgraph-review-v1
REPORT_LANGGRAPH_MAX_PARALLEL_QUESTION_REVIEWS=3
REPORT_LANGGRAPH_MAX_PROVIDER_ATTEMPTS=3
REPORT_LANGGRAPH_MAX_QUALITY_REPAIRS=2
LANGGRAPH_STRICT_MSGPACK=true
INTERVIEW_CHUNK_RETENTION_HOURS=24
DURABLE_WORKFLOW_MAINTENANCE_SECONDS=3600
LANGGRAPH_CANARY_SIGNAL_RETENTION_HOURS=168
# Optional Celery profile. Keep credentials local and never commit the real URL.
REDIS_URL=redis://:your-password@127.0.0.1:6379/0

# DeepSeek/OpenAI-compatible LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
LLM_CONTEXT_WINDOW_TOKENS=128000
LLM_CONTEXT_PROTOCOL_RESERVE_TOKENS=512
LLM_STRUCTURED_OUTPUT_RESERVE_TOKENS=2048
LLM_CONTEXT_SAFETY_MARGIN_TOKENS=1024
# Optional only when the deployed provider is verified to use this tokenizer.
# LLM_TOKENIZER_FAMILY=cl100k_base
# Structured memory configuration (WP-8a). These are commented during the
# compatibility window; when enabled, matching legacy variables below may
# remain temporarily, but conflicting normalized values fail preflight.
# MEMORY_INTERVIEW_GRAPH_RUNTIME_ENABLED=true
# MEMORY_INTERVIEW_GRAPH_VERSION=langgraph-v1
# MEMORY_INTERVIEW_GRAPH_ROLLOUT_PERCENT=0
# MEMORY_MODEL_CONTEXT_WINDOW_TOKENS=128000
# MEMORY_MODEL_PROTOCOL_RESERVE_TOKENS=512
# MEMORY_MODEL_STRUCTURED_OUTPUT_RESERVE_TOKENS=2048
# MEMORY_MODEL_SAFETY_MARGIN_TOKENS=1024
# MEMORY_MODEL_TOKENIZER_FAMILY=cl100k_base
# MEMORY_BUDGET_MODE=disabled
# MEMORY_BUDGET_SHADOW_ENABLED=false
# Budget Shadow target and observation window are CLI/runbook inputs, not
# environment activation switches. Repository execution remains validate-only.
# MEMORY_BUDGET_ENFORCEMENT_PREP=false
# MEMORY_BUDGET_ENFORCEMENT_INTERVIEW=false
# MEMORY_BUDGET_ENFORCEMENT_REVIEW=false
# MEMORY_BUDGET_ENFORCEMENT_REPORT=false
# MEMORY_COMPRESSION_MODE=disabled
# MEMORY_COMPRESSION_SHADOW_ENABLED=false
# MEMORY_COMPRESSION_PREP=false
# MEMORY_COMPRESSION_INTERVIEW_QUESTION_MEMORY=false
# MEMORY_COMPRESSION_EVIDENCE=false
# MEMORY_COMPRESSION_REVIEW=false
# MEMORY_ARTIFACT_STORE_AVAILABLE=true
# MEMORY_ARTIFACT_LEASE_SECONDS=60
# MEMORY_RETENTION_SESSION_DAYS=90
# MEMORY_RETENTION_REPORT_DAYS=90
# MEMORY_RETENTION_CHECKPOINT_DAYS=30
# MEMORY_RETENTION_ARTIFACT_UNREFERENCED_HOURS=24
# MEMORY_RETENTION_ARTIFACT_FAILED_HOURS=24
# MEMORY_RETENTION_PREP_REF_HOURS=168
# MEMORY_RETENTION_CLEANUP_BATCH_SIZE=200
# MEMORY_PRIVACY_DEPLOYMENT_ID=single-tenant-local
# Destructive deletion has no product identity boundary in Local V1. Keep it
# hidden unless this process runs inside an explicitly trusted local profile.
# MEMORY_TRUSTED_LOCAL_DELETION_ENABLED=false
# MEMORY_TRUSTED_LOCAL_METRICS_ENABLED=false
# Principal Memory remains repository-only until an authenticated identity
# boundary exists. These gates must stay disabled in committed defaults.
# MEMORY_TRUSTED_LOCAL_PRINCIPAL_MEMORY_API_ENABLED=false
# A Local Principal is an explicit single-user binding. Never populate this
# identifier from candidate content, request metadata, resumes, or model output.
# MEMORY_LOCAL_PRINCIPAL_ENABLED=false
# MEMORY_LOCAL_PRINCIPAL_ID=local-owner
# Optional absolute private JSONL path outside Git and application backups.
# When configured, Principal deletion does not report completion until the
# completed tombstone is durably appended to this operator-owned ledger.
# MEMORY_PRINCIPAL_TOMBSTONE_LEDGER_PATH=C:\private\principal-memory-tombstones.jsonl
# MEMORY_LONG_TERM_MODE=disabled
# MEMORY_LONG_TERM_WRITE_SHADOW_ENABLED=false
# MEMORY_LONG_TERM_READ_SHADOW_ENABLED=false
# MEMORY_LONG_TERM_LOCAL_CONSUMPTION_ENABLED=false
# MEMORY_LONG_TERM_CONSENT_POLICY_VERSION=principal-memory-consent-v1
# MEMORY_LONG_TERM_FACT_SCHEMA_VERSION=principal-memory-fact-v1
# MEMORY_LONG_TERM_TAXONOMY_VERSION=principal-memory-taxonomy-v1
# MEMORY_LONG_TERM_MAX_PROPOSALS_PER_SESSION=8
# MEMORY_LONG_TERM_MAX_SHADOW_FACTS=6
# MEMORY_LONG_TERM_MAX_SHADOW_TOKENS=800
# MEMORY_LONG_TERM_MAX_LOCAL_CONSUME_FACTS=3
# MEMORY_LONG_TERM_MAX_LOCAL_CONSUME_TOKENS=120
# MEMORY_LONG_TERM_PROPOSAL_RETENTION_DAYS=7
# MEMORY_LONG_TERM_ACTIVE_FACT_DEFAULT_DAYS=180
# Local Consume additionally requires PostgreSQL and complete durable aggregate
# metrics. Validate the private runtime without changing it:
# python -m scripts.local_principal_memory preflight
# Operator cleanup and tombstone replay require an explicit --execute flag; see
# docs/local-principal-memory-operations.md. Never commit a tombstone ledger.
CONTEXT_BUDGET_SHADOW_ENABLED=false
CONTEXT_BUDGET_PREP_ENFORCEMENT=false
CONTEXT_BUDGET_INTERVIEW_ENFORCEMENT=false
CONTEXT_BUDGET_REVIEW_ENFORCEMENT=false
CONTEXT_BUDGET_REPORT_ROUTING=false
CONTEXT_COMPRESSION_SHADOW_ENABLED=false
CONTEXT_COMPRESSION_PREP_ENABLED=false
CONTEXT_COMPRESSION_INTERVIEW_ENABLED=false
CONTEXT_COMPRESSION_EVIDENCE_ENABLED=false
CONTEXT_COMPRESSION_REVIEW_ENABLED=false
CONTEXT_ARTIFACT_LEASE_SECONDS=60
CONTEXT_ARTIFACT_UNREFERENCED_RETENTION_HOURS=24
CONTEXT_ARTIFACT_FAILED_RETENTION_HOURS=24
CONTEXT_ARTIFACT_PREP_REF_RETENTION_HOURS=168
CONTEXT_ARTIFACT_CLEANUP_BATCH_SIZE=200
CONTEXT_ARTIFACT_DEPLOYMENT_SCOPE=single-tenant-local
OPENAI_TEMPERATURE=0.2
# Bound provider calls so report fallback can complete after an upstream timeout.
OPENAI_REQUEST_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=1
# structured_first is the production default; raw_only is useful for compatible-provider RC runs.
OPENAI_REPORT_OUTPUT_MODE=structured_first

# Optional report trace output for debugging provider payloads.
REPORT_TRACE_DIR=tmp/report_traces
# Optional Agent metadata trace output. Tracing is disabled when unset.
AGENT_TRACE_DIR=

# Stage 40 evaluation uses the existing OPENAI-compatible provider settings.
# Generated artifacts never contain this key.
STAGE40_MAX_PROVIDER_INVOCATIONS=50
