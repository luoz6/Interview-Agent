{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:interview-agent:hosted-v2-productization-decision-v1",
  "title": "Hosted V2 Productization Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "adr_sha256",
    "repository_revision",
    "product_scope",
    "deployment_model",
    "approved_regions",
    "oidc_provider_class",
    "account_recovery_model",
    "support_and_on_call_model",
    "local_v1_unchanged",
    "data_use_spec_still_required",
    "decision_time",
    "expires_at",
    "review_expiry_or_revalidation_trigger",
    "approvals"
  ],
  "properties": {
    "schema_version": {
      "const": "hosted-v2-productization-decision-v1"
    },
    "decision": {
      "const": "GO"
    },
    "adr_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "repository_revision": {
      "$ref": "#/$defs/revision"
    },
    "product_scope": {
      "const": "HOSTED_MULTI_USER_V2"
    },
    "deployment_model": {
      "const": "DEPLOYMENT_SCOPED_MULTI_USER"
    },
    "approved_regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/concrete_string"
      }
    },
    "oidc_provider_class": {
      "$ref": "#/$defs/concrete_string"
    },
    "account_recovery_model": {
      "const": "NO_AUTOMATIC_MEMORY_INHERITANCE"
    },
    "support_and_on_call_model": {
      "$ref": "#/$defs/concrete_string"
    },
    "local_v1_unchanged": {
      "const": true
    },
    "data_use_spec_still_required": {
      "const": true
    },
    "decision_time": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_expiry_or_revalidation_trigger": {
      "$ref": "#/$defs/concrete_string"
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "change_owner",
        "operations",
        "privacy",
        "security",
        "fairness",
        "accessibility",
        "interview_quality",
        "legal"
      ],
      "properties": {
        "product": { "$ref": "#/$defs/approval" },
        "change_owner": { "$ref": "#/$defs/approval" },
        "operations": { "$ref": "#/$defs/approval" },
        "privacy": { "$ref": "#/$defs/approval" },
        "security": { "$ref": "#/$defs/approval" },
        "fairness": { "$ref": "#/$defs/approval" },
        "accessibility": { "$ref": "#/$defs/approval" },
        "interview_quality": { "$ref": "#/$defs/approval" },
        "legal": { "$ref": "#/$defs/approval" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "concrete_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!(?:TBD|TODO|UNKNOWN|UNSET|NONE|N/A|PLACEHOLDER|\\*)$).+"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "external_ref", "decided_at"],
      "properties": {
        "decision": { "const": "APPROVED" },
        "external_ref": { "$ref": "#/$defs/concrete_string" },
        "decided_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
